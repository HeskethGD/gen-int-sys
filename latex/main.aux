\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Comparison of the prescribed inverse-spherical-Bessel solutions (lines) with direct numerical integration of the coupled Hamiltonian system (markers). The parameters are $a_1=2.3$, $a_2=1.35$, $b_1=6.4$, and $b_2=9.7$, with $x_1(0)=5.8116$, $x_2(0)=3.4584$, and $\alpha _1=\alpha _2=1$ in \eqref  {eq:inverse-j1-mode-solutions}. Thus $u_j(0)=\sqrt  {x_j(0)}\exp [a_j\operatorname  {Si}(b_jx_j(0))]$ and $v_j(0)=x_j(0)/u_j(0)$, giving $\rho (0)=-4.635$ on the selected branch of $j_1^{-1}$. Numerical integration uses SciPy \texttt  {solve\_ivp} with DOP853, relative tolerance $10^{-11}$, absolute tolerance $10^{-13}$, and maximum step $0.05$. The comparison stops at $98\%$ of the interval to the next critical point of $j_1$; the mode panel uses a logarithmic vertical scale.}}{32}{figure.caption.2}\protected@file@percent }
\newlabel{fig:inverse-j1-example}{{2}{32}{Comparison of the prescribed inverse-spherical-Bessel solutions (lines) with direct numerical integration of the coupled Hamiltonian system (markers). The parameters are $a_1=2.3$, $a_2=1.35$, $b_1=6.4$, and $b_2=9.7$, with $x_1(0)=5.8116$, $x_2(0)=3.4584$, and $\alpha _1=\alpha _2=1$ in \eqref {eq:inverse-j1-mode-solutions}. Thus $u_j(0)=\sqrt {x_j(0)}\exp [a_j\operatorname {Si}(b_jx_j(0))]$ and $v_j(0)=x_j(0)/u_j(0)$, giving $\rho (0)=-4.635$ on the selected branch of $j_1^{-1}$. Numerical integration uses SciPy \texttt {solve\_ivp} with DOP853, relative tolerance $10^{-11}$, absolute tolerance $10^{-13}$, and maximum step $0.05$. The comparison stops at $98\%$ of the interval to the next critical point of $j_1$; the mode panel uses a logarithmic vertical scale}{figure.caption.2}{}}
